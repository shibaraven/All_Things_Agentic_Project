# Local default is shiftzero-local-demo. Always override this in Cloud Run.
SHIFTZERO_DEMO_TOKEN=replace-with-a-random-secret
SHIFTZERO_TICK_INTERVAL_SECONDS=0.05
SHIFTZERO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SHIFTZERO_COMMANDER_MODE=auto
SHIFTZERO_COMMANDER_TIMEOUT_SECONDS=30
SHIFTZERO_COMMANDER_MIN_CONFIDENCE=0.65
SHIFTZERO_GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=asia-east1
SHIFTZERO_CLOUD_EVIDENCE_ENABLED=false
SHIFTZERO_PUBSUB_TOPIC=shiftzero-events
SHIFTZERO_FIRESTORE_DATABASE=(default)
SHIFTZERO_CLOUD_TRACE_ENABLED=false
SHIFTZERO_CONTENT_GUARD_MODE=auto
SHIFTZERO_MODEL_ARMOR_LOCATION=asia-southeast1
SHIFTZERO_MODEL_ARMOR_TEMPLATE=shiftzero-ingress
# GOOGLE_API_KEY=only-for-local-Gemini-Developer-API-testing
